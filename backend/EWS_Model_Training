    "import pandas as pd\n",
    "from sqlalchemy import create_engine\n",
    "\n",
    "# Connect to the same MySQL database the Flask app uses\n",
    "engine = create_engine(\"mysql+pymysql://root:@localhost:3306/riskwatch_db\")\n",
    "\n",
    "# Pull academic records joined with student info\n",
    "query = \"\"\"\n",
    "SELECT \n",
    "    s.student_id, s.student_number, s.full_name, s.program, s.level,\n",
    "    a.course_code, a.semester, a.gpa, a.continuous_assessment,\n",
    "    a.attendance_percent, a.assignment_submission_rate, a.lms_engagement_score\n",
    "FROM academic_records a\n",
    "JOIN students s ON s.student_id = a.student_id\n",
    "\"\"\"\n",
    "\n",
    "df = pd.read_sql(query, engine)\n",
    "df.head()"
   ]
  },
