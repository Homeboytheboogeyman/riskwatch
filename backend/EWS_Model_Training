   "source": [
    "# Aggregate to one row per student (average across their course records)\n",
    "student_df = df.groupby([\"student_id\", \"student_number\", \"full_name\"]).agg({\n",
    "    \"gpa\": \"mean\",\n",
    "    \"continuous_assessment\": \"mean\",\n",
    "    \"attendance_percent\": \"mean\",\n",
    "    \"assignment_submission_rate\": \"mean\",\n",
    "    \"lms_engagement_score\": \"mean\",\n",
    "}).reset_index()\n",
    "\n",
    "# Define \"at-risk\" label using a simple rule based on the same logic we seeded with:\n",
    "# low GPA + low attendance together = at risk. This becomes our training target.\n",
    "student_df[\"at_risk\"] = (\n",
    "    (student_df[\"gpa\"] < 2.5) & (student_df[\"attendance_percent\"] < 65)\n",
    ").astype(int)\n",
    "\n",
    "student_df[\"at_risk\"].value_counts()"
   ]
  },
